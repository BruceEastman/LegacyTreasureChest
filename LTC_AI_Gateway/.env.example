# ---------------------------------
# Kill Switches
# ---------------------------------
LTC_DISABLE_ALL_AI=false
LTC_DISABLE_GEMINI=false
LTC_DISABLE_PLACES=false

# ---------------------------------
# Rate Limits
# ---------------------------------
LTC_AI_PER_MINUTE_LIMIT=60
LTC_AI_PER_DAY_LIMIT=200
LTC_ANALYZE_PER_MINUTE_LIMIT=10
# Places Text Search calls per instance per day (all devices)
LTC_PLACES_PER_DAY_LIMIT=30
# Local Help searches per device per day
LTC_PLACES_SEARCHES_PER_DEVICE_DAY_LIMIT=20
# Places queries per partner type per search
LTC_PLACES_MAX_QUERIES_PER_TYPE=2

# ---------------------------------
# Local Help partner discovery
# ---------------------------------
# google (default when unset) | stub (local development only; refused on Cloud Run)
PARTNER_DISCOVERY_PROVIDER=google

# ---------------------------------
# Required Cloud Secrets (set in Cloud Run)
# ---------------------------------
GEMINI_API_KEY=your_gemini_key_here
GOOGLE_PLACES_API_KEY=your_places_key_here